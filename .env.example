# Application
APP_ENV=production
APP_DEBUG=false
# Sub-directory under which the app is served (empty when at domain root), e.g. /Lettie/public
APP_BASE_PATH=
APP_TIMEZONE=Europe/Paris
APP_LOCALE=fr

# Database (MariaDB 10.11)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=lettie
DB_USER=lettie
DB_PASSWORD=

# Session cookie sent over HTTPS only (true in production)
SESSION_SECURE=true
SESSION_NAME=lettie_session
SESSION_LIFETIME=7200
# Lax or Strict
SESSION_SAMESITE=Lax

# Private files (attachments), outside public/. Default: <project>/storage
STORAGE_PATH=
# Maximum attachment size in bytes (20 MB). Keep upload_max_filesize/post_max_size above it.
ATTACHMENT_MAX_BYTES=20971520

# Public address of the application, without trailing slash (links sent by e-mail), e.g. https://lettie.example.org
APP_URL=

# E-mail ("Mot de passe oublié"). Leave MAIL_HOST empty to turn the feature off.
MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS, port 587), ssl (port 465) or none
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Lettie
