# Used when the web server's document root is the project folder itself: local development under
# http://localhost/Lettie/ (XAMPP, APP_BASE_PATH=/Lettie) or a host whose root cannot be changed
# (APP_BASE_PATH empty). Every request is served from public/: .env, vendor/, storage/, app/… are
# never reachable. Prefer pointing the document root to public/ (see docs/scheduled-task-plesk.md).
# No folder name is written here: the same file works at any address.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Anything not already inside public/ is mapped into it.
    RewriteRule ^public/ - [L]
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Without mod_rewrite, refuse everything rather than expose the project.
<IfModule !mod_rewrite.c>
    Require all denied
</IfModule>

# Defence in depth: dotfiles (.env, .git…) are never served.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
